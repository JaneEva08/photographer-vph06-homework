# Copy to .env on the server and replace all sample values.
POSTGRES_DB=photographer
POSTGRES_USER=photographer_app
# The database password is supplied to PostgreSQL via Compose secret file,
# not as a process environment variable. Create it with scripts/create-secrets.sh.

PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_PORT=5050
BACKEND_PORT=8000
NGINX_BIND=0.0.0.0
NGINX_HTTP_PORT=80
COOKIE_SECURE=false
DOMAIN=replace-with-your-domain.example

# Google Sheets sync is configured in compose.sheets.yaml.
# GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_private_workbook_id

# Keep loopback until TLS is installed and the VPS firewall is restricted.
REGISTRY_BIND=127.0.0.1
REGISTRY_PORT=5000
